# LLM API Keys (Key ids are key_1, key_2, ... in priority order)
# Supports multi-provider key pools with automatic failover:
# Format: key_1:provider/model:api_key,key_2:provider/model:api_key
LLM_API_KEYS=key_1:groq/openai/gpt-oss-20b:YOUR_GROQ_API_KEY,key_2:gemini/gemini-2.5-flash-lite:YOUR_GEMINI_API_KEY,key_3:groq/openai/gpt-oss-120b:YOUR_GROQ_API_KEY

# SQLite Database URL
# In Docker: sqlite:////data/app.db
# Locally: sqlite:///./data/app.db
DATABASE_URL=sqlite:///./data/app.db

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://lyftr-chat.vercel.app

# Failover Test Hook (must be true on deployed backend for evaluator)
ENABLE_FAILURE_SIMULATION=true

# Default LLM Model
DEFAULT_MODEL=groq/openai/gpt-oss-20b
