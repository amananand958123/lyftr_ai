# LLM API Keys (Key ids are key_1, key_2, ... in priority order)
# Supports: key_1:provider/model:api_key,key_2:provider/model:api_key
# Or simple comma-separated keys: key_1_secret,key_2_secret
LLM_API_KEYS=key_1:gemini/gemini-2.0-flash:YOUR_GEMINI_KEY_1,key_2:gemini/gemini-2.0-flash:YOUR_GEMINI_KEY_2

# SQLite Database URL
# In Docker: sqlite:////data/app.db
# Locally: sqlite:///./data/app.db or sqlite:///./app.db
DATABASE_URL=sqlite:////data/app.db

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Failover Test Hook (must be true on deployed backend for evaluator)
ENABLE_FAILURE_SIMULATION=true

# Default LLM Model
DEFAULT_MODEL=gemini/gemini-2.0-flash
